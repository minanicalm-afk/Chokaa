# Pooled Neon connection. Used by the app at runtime.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Direct (non-pooled) Neon connection. Used only by drizzle-kit migrate.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Single shared password for /admin in v1.
ADMIN_PASSWORD=change-me

# M-Pesa Daraja via pesafy. Use sandbox until go-live.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_ENVIRONMENT=sandbox
MPESA_CALLBACK_URL=https://yourdomain.co.ke/api/mpesa/callback
